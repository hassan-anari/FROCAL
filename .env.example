VITE_APP_ENV=development
VITE_DATA_SOURCE=local
VITE_API_BASE_PATH=/api/v1
VITE_ENABLE_DEV_PANEL=true
VITE_TELEGRAM_BOT_URL=https://t.me/DalexioBot?start=dexoairdrop

# Optional production demo analytics. Copy the exact ingestion host from PostHog.
# Empty configuration, development/local/MSW and unit tests never initialize it.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_REPLAY_ENABLED=false

# Demo default: configured authenticated users receive analytics + masked replay
# without a popup. Set true for a real public release requiring opt-in.
# Earlier explicit opt-outs remain respected in demo mode.
VITE_POSTHOG_REQUIRE_CONSENT=false
