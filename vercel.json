{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vendor/telegram/telegram-web-app-124bdff7.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/client-release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/",
      "destination": "https://api.dalexio.com/api/v1/"
    },
    {
      "source": "/api/v1",
      "destination": "https://api.dalexio.com/api/v1/"
    },
    {
      "source": "/api/v1/:section/",
      "destination": "https://api.dalexio.com/api/v1/:section/"
    },
    {
      "source": "/api/v1/:section",
      "destination": "https://api.dalexio.com/api/v1/:section/"
    },
    {
      "source": "/api/v1/:section/:path*/",
      "destination": "https://api.dalexio.com/api/v1/:section/:path*"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://api.dalexio.com/api/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "ai/b1-frontend-foundation": false,
      "ai/b2-frontend-instant-tap": false,
      "ai/b3-frontend-integration": false
    }
  }
}
