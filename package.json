{
  "name": "dalexio-miniapp-phase6-arena",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mock:init": "msw init public --save",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "check": "npm run validate:structure && npm run validate:assets && npm run validate:imports && npm run validate:motion && npm run validate:production && npm run typecheck && npm run test && npm run build && npm run validate:production-bundle",
    "validate:production": "node --test scripts/production-policy.test.mjs",
    "validate:production-bundle": "node scripts/validate-production-bundle.mjs",
    "validate:imports": "node scripts/validate-imports.mjs",
    "validate:motion": "node scripts/validate-motion.mjs",
    "validate:telegram-sdk": "node scripts/validate-telegram-sdk.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.131.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
